[Unit]
Description=grok-leash - Runaway subagent monitor (defense against token-explosive loops)
Documentation=https://github.com/magnusmalm/grok-leash
After=graphical-session.target

[Service]
Type=simple

# The launcher (grok-leash-monitor) will automatically cd into the project root
# if PROJECT_DIR is set in the environment or if the service is started while
# the user is inside the git repository.
#
# If you need to force a specific directory, uncomment and set it:
# WorkingDirectory=%h/path/to/your/grok-leash

ExecStart=%h/.local/bin/grok-leash-monitor

Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=grok-leash

[Install]
WantedBy=default.target
